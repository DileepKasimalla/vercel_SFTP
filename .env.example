# ---------------------------------------------------------------- database
# Local Postgres. Create it once with:
#   createdb fedex_sftp
DATABASE_URL=postgresql://postgres:PostgreSQL1234@localhost:5432/fedex_sftp

# On Vercel, add the Neon integration and it injects DATABASE_URL / POSTGRES_URL
# automatically. Prefer Neon's POOLED connection string for serverless.

# ---------------------------------------------------------------- auth
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
DOWNLOAD_TOKEN_SECONDS=120

# Optional. When set, the one-time bootstrap page also demands this value, so a
# stranger cannot claim the admin account on a freshly deployed public URL.
# BOOTSTRAP_TOKEN=some-long-random-string

# ---------------------------------------------------------------- storage
# auto  -> blob when BLOB_READ_WRITE_TOKEN is present, otherwise local
# local -> write into LOCAL_STORAGE_DIR
# blob  -> Vercel Blob
STORAGE_BACKEND=auto
LOCAL_STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# ---------------------------------------------------------------- retention
# Every file is permanently deleted this many days after upload, downloaded or
# not. Downloading a PDF also removes it from that user's dashboard immediately
# (other recipients keep seeing it until this window ends).
RETENTION_DAYS=5

# Vercel sets this for you when you add a cron job; it is the shared secret the
# scheduled cleanup call must present. An admin's own token also works.
# CRON_SECRET=some-long-random-string

# Set automatically when you create a Vercel Blob store in the dashboard.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# ---------------------------------------------------------------- misc
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
